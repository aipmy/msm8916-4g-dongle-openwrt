#!/bin/sh

# 1. Create modem interface
uci set network.modem=interface
uci set network.modem.proto="modemmanager"
uci set network.modem.device="qcom-soc"
uci set network.modem.auth="none"
uci set network.modem.apn="internet"
uci set network.modem.allowedmode="4g|3g"
uci set network.modem.preferredmode="4g"
uci set network.modem.ifname="wwan0"
uci del_list firewall.@zone[1].network="modem"
uci add_list firewall.@zone[1].network="modem"

# 2. Fix uhttpd ucode prefix for LuCI in OpenWrt 25.12
uci -q del_list uhttpd.main.lua_prefix="/cgi-bin/luci=/usr/lib/lua/luci/sgi/uhttpd.lua"
uci -q del_list uhttpd.main.ucode_prefix="/cgi-bin/luci=/usr/share/ucode/luci/uhttpd.uc"
uci add_list uhttpd.main.ucode_prefix="/cgi-bin/luci=/usr/share/ucode/luci/uhttpd.uc"

# 3. Web terminal autologin as root (no password prompt inside LuCI web terminal)
uci -q set ttyd.@ttyd[0].command="/bin/login -f root"

# 4. Clean up ports and board json
uci -q del_list "network.@device[0].ports=eth0" 2>/dev/null || true
sed -i "s/\"device\": \"eth0\"/\"device\": \"br-lan\"/g" /etc/board.json 2>/dev/null || true

# 5. Remove target-specific APK feed
sed -i "\|/targets/msm89xx/msm8916/packages|d" /etc/apk/repositories.d/distfeeds.list 2>/dev/null || true

uci commit
